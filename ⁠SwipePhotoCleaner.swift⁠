// MARK: - 缩略图异步安全加载组件（自动取消旧请求，防止串图或内存泄漏）
struct AssetThumbnailView: View {
    let asset: PHAsset
    let size: CGSize
    @State private var image: UIImage?
    @State private var requestID: PHImageRequestID = PHInvalidImageRequestID

    var body: some View {
        ZStack(alignment: .bottomTrailing) {
            if let img = image {
                Image(uiImage: img)
                    .resizable()
                    .scaledToFill()
                    .frame(width: size.width, height: size.height)
                    .clipped()
            } else {
                Color.secondary.opacity(0.15)
                    .frame(width: size.width, height: size.height)
            }

            if asset.mediaType == .video {
                Image(systemName: "video.fill")
                    .font(.system(size: 10))
                    .foregroundColor(.white)
                    .padding(4)
                    .shadow(radius: 2)
            }
        }
        .frame(width: size.width, height: size.height)
        .onAppear {
            loadThumbnail()
        }
        .onDisappear {
            cancelRequest()
        }
    }

    private func loadThumbnail() {
        cancelRequest()
        let targetAssetID = asset.localIdentifier
        let options = PHImageRequestOptions()
        options.deliveryMode = .opportunistic
        options.resizeMode = .fast
        options.isNetworkAccessAllowed = true

        let scale = min(UIScreen.main.scale, 2.0)
        let target = CGSize(width: size.width * scale, height: size.height * scale)

        requestID = PHImageManager.default().requestImage(
            for: asset,
            targetSize: target,
            contentMode: .aspectFill,
            options: options
        ) { result, _ in
            guard let result = result, targetAssetID == asset.localIdentifier else { return }
            DispatchQueue.main.async {
                self.image = result
            }
        }
    }

    private func cancelRequest() {
        if requestID != PHInvalidImageRequestID {
            PHImageManager.default().cancelImageRequest(requestID)
            requestID = PHInvalidImageRequestID
        }
    }
}

// MARK: - 主卡片大图/视频预览组件（支持双指放大看细节与视频播放）
struct AssetDetailCardContent: View {
    let asset: PHAsset
    @State private var image: UIImage?
    @State private var player: AVPlayer?
    @State private var requestID: PHImageRequestID = PHInvalidImageRequestID
    @State private var zoomScale: CGFloat = 1.0

    var body: some View {
        GeometryReader { geo in
            ZStack(alignment: .topTrailing) {
                if asset.mediaType == .video, let player = player {
                    VideoPlayer(player: player)
                        .frame(width: geo.size.width, height: geo.size.height)
                        .onAppear { player.play() }
                        .onDisappear { player.pause() }
                } else if let img = image {
                    Image(uiImage: img)
                        .resizable()
                        .scaledToFit()
                        .scaleEffect(zoomScale)
                        .frame(width: geo.size.width, height: geo.size.height)
                        .gesture(
                            MagnificationGesture()
                                .onChanged { val in
                                    zoomScale = max(1.0, min(val, 4.0))
                                }
                                .onEnded { _ in
                                    withAnimation(.spring(response: 0.25, dampingFraction: 0.8)) {
                                        zoomScale = 1.0
                                    }
                                }
                        )
                } else {
                    ProgressView()
                        .frame(width: geo.size.width, height: geo.size.height)
                }

                if asset.mediaSubtypes.contains(.photoLive) {
                    Label("实况", systemImage: "livephoto")
                        .font(.caption2.weight(.medium))
                        .padding(.horizontal, 8)
                        .padding(.vertical, 4)
                        .background(.ultraThinMaterial)
                        .clipShape(Capsule())
                        .padding(12)
                }
            }
            .onAppear {
                loadMedia(for: asset, containerSize: geo.size)
            }
            .onChange(of: asset.localIdentifier) { _ in
                zoomScale = 1.0
                image = nil
                player?.pause()
                player = nil
                loadMedia(for: asset, containerSize: geo.size)
            }
            .onDisappear {
                player?.pause()
                cancelRequest()
            }
        }
    }

    private func loadMedia(for targetAsset: PHAsset, containerSize: CGSize) {
        cancelRequest()
        let expectedID = targetAsset.localIdentifier

        if targetAsset.mediaType == .video {
            let vOptions = PHVideoRequestOptions()
            vOptions.isNetworkAccessAllowed = true
            vOptions.deliveryMode = .automatic
            PHImageManager.default().requestPlayerItem(forVideo: targetAsset, options: vOptions) { item, _ in
                guard let item = item, targetAsset.localIdentifier == expectedID else { return }
                DispatchQueue.main.async {
                    self.player = AVPlayer(playerItem: item)
                }
            }
        }

        let options = PHImageRequestOptions()
        options.deliveryMode = .opportunistic
        options.isNetworkAccessAllowed = true
        let scale = UIScreen.main.scale
        let target = CGSize(
            width: max(1000, containerSize.width * scale),
            height: max(1000, containerSize.height * scale)
        )

        requestID = PHImageManager.default().requestImage(
            for: targetAsset,
            targetSize: target,
            contentMode: .aspectFit,
            options: options
        ) { result, _ in
            guard let result = result, targetAsset.localIdentifier == expectedID else { return }
            DispatchQueue.main.async {
                self.image = result
            }
        }
    }

    private func cancelRequest() {
        if requestID != PHInvalidImageRequestID {
            PHImageManager.default().cancelImageRequest(requestID)
            requestID = PHInvalidImageRequestID
        }
    }
}
