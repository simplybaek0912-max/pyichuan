// MARK: - 浏览排序模式
enum SortOrder: String, CaseIterable, Identifiable {
    case ascending = "顺序"
    case descending = "逆序"
    case random = "随机"

    var id: String { rawValue }
    var icon: String {
        switch self {
        case .ascending: return "arrow.down"
        case .descending: return "arrow.up"
        case .random: return "shuffle"
        }
    }
}

// MARK: - 相册分组模型
struct AlbumItem: Identifiable, Equatable {
    let id: String
    let title: String
    let subtitle: String?
    let count: Int
    let coverAsset: PHAsset?
    let collection: PHAssetCollection?
    let isUncategorized: Bool

    static func == (lhs: AlbumItem, rhs: AlbumItem) -> Bool {
        lhs.id == lhs.id && lhs.count == rhs.count && lhs.id == rhs.id
    }
}

// MARK: - 操作历史记录（支持连续多步撤回）
struct SwipeActionRecord {
    let asset: PHAsset
    let addedToTrash: Bool
}

// MARK: - 核心相册管理 ViewModel（后台线程加载，万张照片丝滑不卡顿）
@MainActor
final class PhotoCleanerViewModel: ObservableObject {
    @Published var isLoading: Bool = true
    @Published var authorizationStatus: PHAuthorizationStatus = .notDetermined

    // 当前展示的照片队列与当前索引
    @Published var displayAssets: [PHAsset] = []
    @Published var currentIndex: Int = 0

    // 待删除暂存队列（保持添加顺序）
    @Published var trashAssets: [PHAsset] = []
    @Published var actionHistory: [SwipeActionRecord] = []

    // 相册列表与当前选中相册
    @Published var albums: [AlbumItem] = []
    @Published var selectedAlbum: AlbumItem?

    // 当前照片是否已收藏（单独状态确保红心点击瞬时响应）
    @Published var currentIsFavorite: Bool = false

    // 底部提示 Toast（如“已清除 4.2 MB”）
    @Published var toastMessage: String?

    // 剩余未整理照片数量
    @Published var unorganizedTotalCount: Int = 0

    // 持久化设置
    @AppStorage("sortOrder") var sortOrder: SortOrder = .descending
    @AppStorage("onlyUnorganized") var onlyUnorganized: Bool = true
    @AppStorage("lastSelectedAlbumID") private var lastSelectedAlbumID: String = "ALL_PHOTOS"
    @AppStorage("lastViewedAssetID") private var lastViewedAssetID: String = ""

    private let organizedStorageKey = "SwipeCleaner_OrganizedIDs_v1"
    private var organizedIDSet: Set<String> = []
    private var uncategorizedIDSet: Set<String> = []
    private var totalLibraryCount: Int = 0

    let imageManager = PHCachingImageManager()
    private let impactFeedback = UIImpactFeedbackGenerator(style: .light)

    init() {
        if let saved = UserDefaults.standard.stringArray(forKey: organizedStorageKey) {
            organizedIDSet = Set(saved)
        }
        impactFeedback.prepare()
        checkPermissionAndLoad()
    }

    // 异步持久化已整理记录，避免阻塞主线程或触发全局重绘
    private func persistOrganizedIDs() {
        let snapshot = Array(organizedIDSet)
        let key = organizedStorageKey
        unorganizedTotalCount = max(0, totalLibraryCount - organizedIDSet.count)
        Task.detached(priority: .utility) {
            UserDefaults.standard.set(snapshot, forKey: key)
        }
    }

    func markAsOrganized(_ id: String) {
        organizedIDSet.insert(id)
        persistOrganizedIDs()
    }

    func unmarkOrganized(_ id: String) {
        organizedIDSet.remove(id)
        persistOrganizedIDs()
    }

    func resetOrganizedHistory() {
        organizedIDSet.removeAll()
        lastViewedAssetID = ""
        UserDefaults.standard.removeObject(forKey: organizedStorageKey)
        unorganizedTotalCount = totalLibraryCount
        Task {
            await reloadCurrentAlbumAssets()
        }
    }

    var currentAsset: PHAsset? {
        guard displayAssets.indices.contains(currentIndex) else { return nil }
        return displayAssets[currentIndex]
    }

    private func syncCurrentState() {
        if let current = currentAsset {
            currentIsFavorite = current.isFavorite
            lastViewedAssetID = current.localIdentifier
        } else {
            currentIsFavorite = false
        }
    }

    // MARK: - 权限检查与后台加载
    func checkPermissionAndLoad() {
        let status = PHPhotoLibrary.authorizationStatus(for: .readWrite)
        authorizationStatus = status
        if status == .authorized || status == .limited {
            Task {
                await fetchAlbumsAndAssets(showFullLoading: true)
            }
        } else if status == .notDetermined {
            PHPhotoLibrary.requestAuthorization(for: .readWrite) { [weak self] newStatus in
                Task { @MainActor in
                    guard let self = self else { return }
                    self.authorizationStatus = newStatus
                    if newStatus == .authorized || newStatus == .limited {
                        await self.fetchAlbumsAndAssets(showFullLoading: true)
                    } else {
                        self.isLoading = false
                    }
                }
            }
        } else {
            isLoading = false
        }
    }

    /// 在后台线程扫描相册结构与未分类集合，避免 16000+ 张照片卡死界面
    func fetchAlbumsAndAssets(showFullLoading: Bool = false) async {
        if showFullLoading {
            isLoading = true
        }

        let resultData = await Task.detached(priority: .userInitiated) { () -> (Int, Set<String>, [AlbumItem]) in
            let fetchOptions = PHFetchOptions()
            fetchOptions.sortDescriptors = [NSSortDescriptor(key: "creationDate", ascending: false)]
            let allPhotos = PHAsset.fetchAssets(with: fetchOptions)
            let totalCount = allPhotos.count

            // 1. 扫描所有用户自建相册，记录已归类的照片 ID
            var categorizedIDs = Set<String>()
            var userAlbumItems: [AlbumItem] = []

            let userCollections = PHAssetCollection.fetchAssetCollections(with: .album, subtype: .any, options: nil)
            userCollections.enumerateObjects { collection, _, _ in
                let assets = PHAsset.fetchAssets(in: collection, options: fetchOptions)
                if assets.count > 0 {
                    assets.enumerateObjects { asset, _, _ in
                        categorizedIDs.insert(asset.localIdentifier)
                    }
                    userAlbumItems.append(
                        AlbumItem(
                            id: collection.localIdentifier,
                            title: collection.localizedTitle ?? "未命名相册",
                            subtitle: nil,
                            count: assets.count,
                            coverAsset: assets.firstObject,
                            collection: collection,
                            isUncategorized: false
                        )
                    )
                }
            }

            // 2. 计算“未分类”照片 ID 集合及封面
            var uncategorizedSet = Set<String>()
            var firstUncategorizedAsset: PHAsset? = nil
            allPhotos.enumerateObjects { asset, _, _ in
                let id = asset.localIdentifier
                if !categorizedIDs.contains(id) {
                    uncategorizedSet.insert(id)
                    if firstUncategorizedAsset == nil {
                        firstUncategorizedAsset = asset
                    }
                }
            }

            var builtAlbums: [AlbumItem] = []

            // (a) 全部相册
            builtAlbums.append(
                AlbumItem(
                    id: "ALL_PHOTOS",
                    title: "全部相册",
                    subtitle: nil,
                    count: totalCount,
                    coverAsset: allPhotos.firstObject,
                    collection: nil,
                    isUncategorized: false
                )
            )

            // (b) 未分类
            builtAlbums.append(
                AlbumItem(
                    id: "UNCATEGORIZED",
                    title: "未分类",
                    subtitle: "尚未加入任何自建相册",
                    count: uncategorizedSet.count,
                    coverAsset: firstUncategorizedAsset,
                    collection: nil,
                    isUncategorized: true
                )
            )

            // (c) 系统智能相册（个人收藏、视频、截屏、实况照片）
            let smartSubtypes: [PHAssetCollectionSubtype] = [
                .smartAlbumFavorites,
                .smartAlbumVideos,
                .smartAlbumScreenshots,
                .smartAlbumLivePhotos
            ]
            for subtype in smartSubtypes {
                let colResult = PHAssetCollection.fetchAssetCollections(with: .smartAlbum, subtype: subtype, options: nil)
                colResult.enumerateObjects { collection, _, _ in
                    let assets = PHAsset.fetchAssets(in: collection, options: fetchOptions)
                    if assets.count > 0 {
                        builtAlbums.append(
                            AlbumItem(
                                id: collection.localIdentifier,
                                title: collection.localizedTitle ?? "系统相册",
                                subtitle: nil,
                                count: assets.count,
                                coverAsset: assets.firstObject,
                                collection: collection,
                                isUncategorized: false
                            )
                        )
                    }
                }
            }

            // (d) 用户自建相册（如小红书、QQ、醒图等）
            builtAlbums.append(contentsOf: userAlbumItems)

            return (totalCount, uncategorizedSet, builtAlbums)
        }.value

        self.totalLibraryCount = resultData.0
        self.uncategorizedIDSet = resultData.1
        self.albums = resultData.2
        self.unorganizedTotalCount = max(0, totalLibraryCount - organizedIDSet.count)

        if let matched = albums.first(where: { $0.id == lastSelectedAlbumID }) {
            self.selectedAlbum = matched
        } else {
            self.selectedAlbum = albums.first
        }

        if showFullLoading {
            await reloadCurrentAlbumAssets()
            isLoading = false
        }
    }

    /// 根据当前相册、排序方式与“仅看未整理”开关在后台刷新照片列表
    func reloadCurrentAlbumAssets() async {
        guard let album = selectedAlbum else { return }
        lastSelectedAlbumID = album.id
        let rememberedAssetID = lastViewedAssetID

        let currentSort = sortOrder
        let filterUnorganized = onlyUnorganized
        let organizedSnapshot = organizedIDSet
        let uncategorizedSnapshot = uncategorizedIDSet
        let trashIDSet = Set(trashAssets.map(\.localIdentifier))

        let filteredAssets = await Task.detached(priority: .userInitiated) { () -> [PHAsset] in
            let fetchOptions = PHFetchOptions()
            fetchOptions.sortDescriptors = [
                NSSortDescriptor(key: "creationDate", ascending: currentSort == .ascending)
            ]

            let fetchResult: PHFetchResult<PHAsset>
            if album.id == "ALL_PHOTOS" || album.isUncategorized {
                fetchResult = PHAsset.fetchAssets(with: fetchOptions)
            } else if let collection = album.collection {
                fetchResult = PHAsset.fetchAssets(in: collection, options: fetchOptions)
            } else {
                fetchResult = PHAsset.fetchAssets(with: fetchOptions)
            }

            var result: [PHAsset] = []
            result.reserveCapacity(min(fetchResult.count, 5000))

            fetchResult.enumerateObjects { asset, _, _ in
                let id = asset.localIdentifier
                if album.isUncategorized && !uncategorizedSnapshot.contains(id) {
                    return
                }
                if trashIDSet.contains(id) {
                    return
                }
                if filterUnorganized && organizedSnapshot.contains(id) {
                    return
                }
                result.append(asset)
            }

            if currentSort == .random {
                result.shuffle()
            }
            return result
        }.value

        self.displayAssets = filteredAssets
        // 如果之前浏览的照片仍在列表中，自动定位到上次看到的位置
        if !rememberedAssetID.isEmpty,
           let savedIndex = filteredAssets.firstIndex(where: { $0.localIdentifier == rememberedAssetID }) {
            self.currentIndex = savedIndex
        } else {
            self.currentIndex = 0
        }
        self.syncCurrentState()
    }

    // MARK: - 手势与按钮交互

    /// 上滑：移入待删除暂存区
    func swipeUpToDeleteCurrent() {
        guard let asset = currentAsset else { return }
        impactFeedback.impactOccurred()

        let id = asset.localIdentifier
        if !trashAssets.contains(where: { $0.localIdentifier == id }) {
            trashAssets.append(asset)
        }
        markAsOrganized(id)
        actionHistory.append(SwipeActionRecord(asset: asset, addedToTrash: true))

        displayAssets.remove(at: currentIndex)
        if currentIndex >= displayAssets.count {
            currentIndex = max(0, displayAssets.count - 1)
        }
        syncCurrentState()
    }

    /// 左右滑：保留并查看下一张
    func swipeKeepCurrent() {
        guard let asset = currentAsset else { return }
        let id = asset.localIdentifier
        markAsOrganized(id)
        actionHistory.append(SwipeActionRecord(asset: asset, addedToTrash: false))

        if onlyUnorganized {
            displayAssets.remove(at: currentIndex)
            if currentIndex >= displayAssets.count {
                currentIndex = max(0, displayAssets.count - 1)
            }
        } else if currentIndex < displayAssets.count - 1 {
            currentIndex += 1
        }
        syncCurrentState()
    }

    /// 撤回上一步操作（支持连续撤回）
    func undoLastAction() {
        guard let last = actionHistory.popLast() else { return }
        impactFeedback.impactOccurred()

        let id = last.asset.localIdentifier
        unmarkOrganized(id)
        if last.addedToTrash {
            trashAssets.removeAll { $0.localIdentifier == id }
        }

        if !displayAssets.contains(where: { $0.localIdentifier == id }) {
            let insertPos = min(currentIndex, displayAssets.count)
            displayAssets.insert(last.asset, at: insertPos)
            currentIndex = insertPos
        } else if let idx = displayAssets.firstIndex(where: { $0.localIdentifier == id }) {
            currentIndex = idx
        }
        syncCurrentState()
    }

    /// 从待删除列表中单独恢复某张照片
    func restoreFromTrash(_ asset: PHAsset) {
        impactFeedback.impactOccurred()
        let id = asset.localIdentifier
        trashAssets.removeAll { $0.localIdentifier == id }
        actionHistory.removeAll { $0.asset.localIdentifier == id }
        unmarkOrganized(id)

        if !displayAssets.contains(where: { $0.localIdentifier == id }) {
            let insertPos = min(currentIndex, displayAssets.count)
            displayAssets.insert(asset, at: insertPos)
            currentIndex = insertPos
        }
        syncCurrentState()
    }

    /// 切换当前照片的系统“个人收藏”状态
    func toggleFavoriteCurrent() {
        guard let asset = currentAsset else { return }
        impactFeedback.impactOccurred()

        let targetState = !currentIsFavorite
        currentIsFavorite = targetState

        PHPhotoLibrary.shared().performChanges({
            let request = PHAssetChangeRequest(for: asset)
            request.isFavorite = targetState
        }) { [weak self] success, _ in
            Task { @MainActor in
                guard let self = self else { return }
                if success {
                    if let updated = PHAsset.fetchAssets(withLocalIdentifiers: [asset.localIdentifier], options: nil).firstObject,
                       self.displayAssets.indices.contains(self.currentIndex),
                       self.displayAssets[self.currentIndex].localIdentifier == asset.localIdentifier {
                        self.displayAssets[self.currentIndex] = updated
                        self.currentIsFavorite = updated.isFavorite
                    }
                } else {
                    self.currentIsFavorite = !targetState
                }
            }
        }
    }

    /// 真正从系统相册批量删除“待删除”队列中的照片（保持当前画面不闪烁、不跳回开头）
    func commitBatchDeletion(completion: (() -> Void)? = nil) {
        let assetsToDelete = trashAssets
        guard !assetsToDelete.isEmpty else { return }

        // 安全估算文件大小（先检查 responds(to:) 防止异常）
        var totalBytes: Int64 = 0
        let fileSizeSelector = Selector(("fileSize"))
        for asset in assetsToDelete {
            let resources = PHAssetResource.assetResources(for: asset)
            for res in resources {
                if res.responds(to: fileSizeSelector),
                   let size = res.value(forKey: "fileSize") as? Int64 {
                    totalBytes += size
                }
            }
        }

        PHPhotoLibrary.shared().performChanges({
            PHAssetChangeRequest.deleteAssets(assetsToDelete as NSArray)
        }) { [weak self] success, _ in
            guard success else { return }
            Task { @MainActor in
                guard let self = self else { return }
                let deletedIDs = Set(assetsToDelete.map(\.localIdentifier))
                self.trashAssets.removeAll()
                self.actionHistory.removeAll { deletedIDs.contains($0.asset.localIdentifier) }

                let mb = Double(totalBytes) / (1024.0 * 1024.0)
                if mb >= 0.1 {
                    self.showToast(String(format: "已清除 %.1f MB", mb))
                } else {
                    self.showToast("已清理 \(assetsToDelete.count) 张照片")
                }

                // 静默刷新相册计数，不打断当前正在浏览的照片卡片
                await self.fetchAlbumsAndAssets(showFullLoading: false)
                completion?()
            }
        }
    }

    func jumpToAsset(at index: Int) {
        guard displayAssets.indices.contains(index) else { return }
        currentIndex = index
        syncCurrentState()
    }

    private func showToast(_ text: String) {
        withAnimation(.easeInOut(duration: 0.2)) {
            toastMessage = text
        }
        Task {
            try? await Task.sleep(nanoseconds: 2_200_000_000)
            await MainActor.run {
                withAnimation(.easeInOut(duration: 0.2)) {
                    if self.toastMessage == text {
                        self.toastMessage = nil
                    }
                }
            }
        }
    }
}

// MARK: - 主界面
struct PhotoCleanerMainView: View {
    @StateObject private var vm = PhotoCleanerViewModel()
    @State private var showSettings = false
    @State private var showTrashSheet = false
    @State private var showAlbumGridSheet = false
    @State private var dragOffset: CGSize = .zero

    private static let dateFormatter: DateFormatter = {
        let df = DateFormatter()
        df.dateFormat = "yyyy年M月d日"
        return df
    }()

    private static let timeFormatter: DateFormatter = {
        let df = DateFormatter()
        df.dateFormat = "HH:mm"
        return df
    }()

    var body: some View {
        ZStack {
            Color(UIColor.systemGroupedBackground)
                .ignoresSafeArea()

            if vm.isLoading {
                VStack(spacing: 14) {
                    ProgressView()
                        .scaleEffect(1.3)
                    Text("正在整理相册...")
                        .font(.subheadline)
                        .foregroundColor(.secondary)
                }
            } else if vm.authorizationStatus != .authorized && vm.authorizationStatus != .limited {
                permissionGuideView
            } else {
                VStack(spacing: 12) {
                    topHeaderBar
                    thumbnailFilmstrip
                    mainCardArea
                        .frame(maxWidth: .infinity, maxHeight: .infinity)
                    bottomControlBar
                }
                .padding(.horizontal, 16)
                .padding(.bottom, 10)
            }

            if let toast = vm.toastMessage {
                VStack {
                    Spacer()
                    Text(toast)
                        .font(.subheadline.weight(.semibold))
                        .foregroundColor(.white)
                        .padding(.horizontal, 22)
                        .padding(.vertical, 11)
                        .background(Color.black.opacity(0.82))
                        .clipShape(Capsule())
                        .shadow(color: .black.opacity(0.15), radius: 8, y: 4)
                        .padding(.bottom, 92)
                }
                .transition(.opacity.combined(with: .move(edge: .bottom)))
            }
        }
        .sheet(isPresented: $showSettings) {
            SettingsSheetView(vm: vm)
                .presentationDetents([.medium])
        }
        .sheet(isPresented: $showTrashSheet) {
            TrashQueueSheetView(vm: vm)
        }
        .fullScreenCover(isPresented: $showAlbumGridSheet) {
            AlbumOverviewSheetView(vm: vm)
        }
    }

    private var permissionGuideView: some View {
        VStack(spacing: 16) {
            Image(systemName: "photo.on.rectangle.angled")
                .font(.system(size: 50))
                .foregroundColor(.secondary)
            Text("需要相册访问权限")
                .font(.headline)
            Text("请在系统设置中允许访问“完全访问 / 所有照片”，以便浏览、收藏和清理图片。")
                .font(.subheadline)
                .foregroundColor(.secondary)
                .multilineTextAlignment(.center)
                .padding(.horizontal, 36)
            Button("打开系统设置") {
                if let url = URL(string: UIApplication.openSettingsURLString) {
                    UIApplication.shared.open(url)
                }
            }
            .buttonStyle(.borderedProminent)
        }
    }

    // MARK: - 1. 顶部导航栏
    private var topHeaderBar: some View {
        HStack {
            Button {
                showSettings = true
            } label: {
                Image(systemName: "gearshape")
                    .font(.system(size: 18, weight: .medium))
                    .foregroundColor(.primary)
                    .frame(width: 42, height: 42)
                    .background(Color(UIColor.secondarySystemGroupedBackground))
                    .clipShape(Circle())
            }

            Spacer()

            if let asset = vm.currentAsset, let date = asset.creationDate {
                VStack(spacing: 2) {
                    Text(Self.dateFormatter.string(from: date))
                        .font(.system(size: 16, weight: .bold))
                    Text(Self.timeFormatter.string(from: date))
                        .font(.system(size: 12))
                        .foregroundColor(.secondary)
                }
            } else {
                Text(vm.selectedAlbum?.title ?? "全部相册")
                    .font(.system(size: 16, weight: .bold))
            }

            Spacer()

            HStack(spacing: 8) {
                if let asset = vm.currentAsset {
                    Button {
                        shareAsset(asset)
                    } label: {
                        Image(systemName: "square.and.arrow.up")
                            .font(.system(size: 16, weight: .medium))
                            .foregroundColor(.primary)
                            .frame(width: 40, height: 40)
                            .background(Color(UIColor.secondarySystemGroupedBackground))
                            .clipShape(Circle())
                    }
                }

                Button {
                    showAlbumGridSheet = true
                } label: {
                    Image(systemName: "folder")
                        .font(.system(size: 16, weight: .medium))
                        .foregroundColor(.primary)
                        .frame(width: 40, height: 40)
                        .background(Color(UIColor.secondarySystemGroupedBackground))
                        .clipShape(Circle())
                }
            }
        }
        .padding(.top, 4)
    }

    // MARK: - 2. 顶部缩略图胶片条
    private var thumbnailFilmstrip: some View {
        ScrollViewReader { proxy in
            ScrollView(.horizontal, showsIndicators: false) {
                LazyHStack(spacing: 6) {
                    ForEach(Array(vm.displayAssets.enumerated()), id: \.element.localIdentifier) { index, asset in
                        AssetThumbnailView(asset: asset, size: CGSize(width: 44, height: 56))
                            .clipShape(RoundedRectangle(cornerRadius: 6))
                            .overlay(
                                RoundedRectangle(cornerRadius: 6)
                                    .stroke(index == vm.currentIndex ? Color.primary : Color.clear, lineWidth: 2)
                            )
                            .opacity(index == vm.currentIndex ? 1.0 : 0.55)
                            .id(asset.localIdentifier)
                            .onTapGesture {
                                withAnimation(.easeInOut(duration: 0.15)) {
                                    vm.jumpToAsset(at: index)
                                }
                            }
                    }
                }
                .padding(.vertical, 2)
            }
            .frame(height: 60)
            .onChange(of: vm.currentAsset?.localIdentifier) { newID in
                if let id = newID {
                    withAnimation(.easeInOut(duration: 0.2)) {
                        proxy.scrollTo(id, anchor: .center)
                    }
                }
            }
        }
    }

    // MARK: - 3. 中间主卡片区（上滑待删 / 左右滑保留 / 双指缩放预览）
    private var mainCardArea: some View {
        ZStack {
            if let asset = vm.currentAsset {
                ZStack(alignment: .top) {
                    RoundedRectangle(cornerRadius: 24)
                        .fill(Color(UIColor.secondarySystemGroupedBackground))
                        .shadow(color: Color.black.opacity(0.05), radius: 10, x: 0, y: 4)

                    AssetDetailCardContent(asset: asset)
                        .padding(10)
                        .clipShape(RoundedRectangle(cornerRadius: 20))

                    if dragOffset.height < -35 {
                        HStack(spacing: 6) {
                            Image(systemName: "trash.fill")
                            Text("松开移入待删除")
                                .font(.subheadline.weight(.semibold))
                        }
                        .foregroundColor(.white)
                        .padding(.horizontal, 16)
                        .padding(.vertical, 8)
                        .background(Color.red.opacity(0.9))
                        .clipShape(Capsule())
                        .padding(.top, 22)
                    }
                }
                .offset(x: dragOffset.width * 0.45, y: dragOffset.height)
                .rotationEffect(.degrees(Double(dragOffset.width / 28)))
                .gesture(
                    DragGesture(minimumDistance: 16)
                        .onChanged { value in
                            dragOffset = value.translation
                        }
                        .onEnded { value in
                            if value.translation.height < -85 {
                                // 上滑 -> 加入待删除队列
                                withAnimation(.spring(response: 0.24, dampingFraction: 0.82)) {
                                    dragOffset = .zero
                                    vm.swipeUpToDeleteCurrent()
                                }
                            } else if abs(value.translation.width) > 75 || value.translation.height > 90 {
                                // 左右滑或下滑 -> 保留并看下一张
                                withAnimation(.spring(response: 0.24, dampingFraction: 0.82)) {
                                    dragOffset = .zero
                                    vm.swipeKeepCurrent()
                                }
                            } else {
                                withAnimation(.spring(response: 0.24, dampingFraction: 0.82)) {
                                    dragOffset = .zero
                                }
                            }
                        }
                )
            } else {
                VStack(spacing: 14) {
                    Image(systemName: "checkmark.circle.fill")
                        .font(.system(size: 48))
                        .foregroundColor(.green)
                    Text("当前相册已全部整理完毕")
                        .font(.headline)
                    if !vm.trashAssets.isEmpty {
                        Text("左下角还有 \(vm.trashAssets.count) 张待删除照片未清理")
                            .font(.subheadline)
                            .foregroundColor(.secondary)
                    } else if vm.onlyUnorganized {
