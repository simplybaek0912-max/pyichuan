                .frame(maxWidth: .infinity, maxHeight: .infinity)
                .background(Color(UIColor.secondarySystemGroupedBackground))
                .clipShape(RoundedRectangle(cornerRadius: 24))
            }
        }
    }

    // MARK: - 4. 底部操作栏
    private var bottomControlBar: some View {
        HStack(spacing: 14) {
